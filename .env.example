# ── Models ────────────────────────────────────────────────────────────────
# Without keys the cockpit still runs: attendance, voice, style learning and
# every surface work offline, and model-backed steps report the key they need.
ANTHROPIC_API_KEY=      # judgment (Opus), vision (Sonnet), memory extraction (Haiku)
GOOGLE_API_KEY=         # quick turns (Gemini Flash), reasoning (Gemini Pro)

# Per-role overrides, if you want a different model in a seat.
MORPHEUS_MODEL_QUICK=
MORPHEUS_MODEL_HARD=
MORPHEUS_MODEL_JUDGMENT=
MORPHEUS_MODEL_VISION=
MORPHEUS_MODEL_EXTRACT=

# ── Scheduler ─────────────────────────────────────────────────────────────
# "on" starts an in-process timer. Leave unset and drive it with cron:
#   curl -X POST $BASE/api/scheduler -d '{"action":"tick"}'
MORPHEUS_SCHEDULER=
MORPHEUS_SCHEDULER_INTERVAL_MS=60000

# ── Connectors ────────────────────────────────────────────────────────────
# Add {origin}/api/connectors/callback as an aumorpheusised redirect URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/connectors/callback

# ── Write protection ──────────────────────────────────────────────────────
# Cross-origin writes are always refused. Set this to also require a secret on
# every mutating call — do that for anything reachable beyond localhost.
MORPHEUS_API_SECRET=

# ── Misc ──────────────────────────────────────────────────────────────────
MORPHEUS_DATA_DIR=          # defaults to ./.morpheus
MORPHEUS_LAT=32.0853        # weather readout
MORPHEUS_LON=34.7818

# ── LinkedIn (optional, opt-in publishing) ────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Serverless persistence ────────────────────────────────────────────────
# Set both to move state off the filesystem. Required on serverless, where
# .morpheus/ is per-instance and ephemeral.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Images ────────────────────────────────────────────────────────────────
MORPHEUS_MODEL_IMAGE=imagen-4.0-generate-001
MORPHEUS_IMAGE_ASPECT=1:1

# ── Slack (gate notifications) ────────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_DEFAULT_CHANNEL=      # e.g. #morpheus

# ── Who this cockpit belongs to ───────────────────────────────────────────
# Blank means the greeting simply omits a name and no weather is shown —
# better than greeting the wrong person in the wrong city.
MORPHEUS_OPERATOR=                  # e.g. Nino — the brief greets you by this
MORPHEUS_TZ=                        # IANA zone, e.g. Asia/Tbilisi. The brief is
                                # derived server-side, so without this the
                                # greeting uses the host's clock, not yours.
MORPHEUS_DAY_START=9                # Your working day. Capacity never exceeds what
MORPHEUS_DAY_END=18                 # is left of it — at 16:00 you do not have 6h.

# Intelligence sources. Comma-separated "Name|https://url" pairs; leave blank
# for the defaults in lib/feeds.ts. Relevance needs no API key — articles are
# matched against your own products' vocabulary.
MORPHEUS_FEEDS=

# Groq — the fast path and the voice path. GPT-OSS 120B serves `quick` and
# `extract`; it is deliberately NOT trusted with consequential judgment, which
# reports itself unavailable rather than downgrading. See docs/AUTHORITY.md.
GROQ_API_KEY=
MORPHEUS_CITY=                      # e.g. Tbilisi
MORPHEUS_LAT=                       # e.g. 41.7151 — required for weather
MORPHEUS_LON=                       # e.g. 44.8271

# ── Voice character ───────────────────────────────────────────────────────
# Defaults aim deep and slow. 0 is the lowest pitch the spec allows; below
# ~0.7 rate the diction starts to smear.
NEXT_PUBLIC_MORPHEUS_VOICE_PITCH=0
NEXT_PUBLIC_MORPHEUS_VOICE_RATE=0.78
NEXT_PUBLIC_MORPHEUS_VOICE=         # exact voice name, e.g. "Microsoft David - English (United States)"
