# ── Models ────────────────────────────────────────────────────────────────
# Without keys the cockpit still runs: attendance, voice, style learning and
# every surface work offline, and model-backed steps report the key they need.
ANTHROPIC_API_KEY=      # judgment (Opus), vision (Sonnet), memory extraction (Haiku)
GOOGLE_API_KEY=         # quick turns (Gemini Flash), reasoning (Gemini Pro)

# Per-role overrides, if you want a different model in a seat.
MORPHEUS_MODEL_QUICK=
MORPHEUS_MODEL_HARD=
MORPHEUS_MODEL_JUDGMENT=
MORPHEUS_MODEL_JUDGMENT_GROQ=openai/gpt-oss-120b
MORPHEUS_MODEL_VISION=
MORPHEUS_MODEL_EXTRACT=

# ── Scheduler ─────────────────────────────────────────────────────────────
# "on" starts an in-process timer. Leave unset and drive it with cron:
#   curl -X POST $BASE/api/scheduler -d '{"action":"tick"}'
MORPHEUS_SCHEDULER=
MORPHEUS_SCHEDULER_INTERVAL_MS=60000

# ── Connectors ────────────────────────────────────────────────────────────
# Add {origin}/api/connectors/callback as an authorised redirect URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:4173/api/connectors/callback

# Facebook Pages — read/list only by default. Create a Meta app and add the
# same callback URL in Facebook Login settings.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_OAUTH_REDIRECT_URI=http://127.0.0.1:4173/api/connectors/callback

# ── Write protection ──────────────────────────────────────────────────────
# Cross-origin writes are always refused. Set this to also require a secret on
# every mutating call — do that for anything reachable beyond localhost.
MORPHEUS_API_SECRET=

# ── Misc ──────────────────────────────────────────────────────────────────
MORPHEUS_DATA_DIR=          # defaults to ./.morpheus
MORPHEUS_LAT=32.0853        # weather readout
MORPHEUS_LON=34.7818

# ── LinkedIn (optional, opt-in publishing) ────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202605
LINKEDIN_OAUTH_REDIRECT_URI=http://127.0.0.1:4173/api/connectors/callback

# ── Serverless persistence ────────────────────────────────────────────────
# Set both to move state off the filesystem. Required on serverless, where
# .morpheus/ is per-instance and ephemeral.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Images ────────────────────────────────────────────────────────────────
MORPHEUS_MODEL_IMAGE=imagen-4.0-generate-001
MORPHEUS_IMAGE_ASPECT=1:1

# ── Slack (gate notifications) ────────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_DEFAULT_CHANNEL=      # e.g. #morpheus

# ── Who this cockpit belongs to ───────────────────────────────────────────
# Blank means the greeting simply omits a name and no weather is shown —
# better than greeting the wrong person in the wrong city.
MORPHEUS_OPERATOR=                  # e.g. Nino — the brief greets you by this
MORPHEUS_TZ=                        # IANA zone, e.g. Asia/Tbilisi. The brief is
                                # derived server-side, so without this the
                                # greeting uses the host's clock, not yours.
MORPHEUS_DAY_START=9                # Your working day. Capacity never exceeds what
MORPHEUS_DAY_END=18                 # is left of it — at 16:00 you do not have 6h.

# Intelligence sources. Comma-separated "Name|https://url" pairs; leave blank
# for the defaults in lib/feeds.ts. Relevance needs no API key — articles are
# matched against your own products' vocabulary.
MORPHEUS_FEEDS=
# Live conversational news. Comma-separated Name|RSS URL pairs. Defaults to
# Hugging Face Blog and GitHub Changelog; Morpheus always names this coverage.
MORPHEUS_NEWS_FEEDS=

# Groq — the free fast, reasoning, extraction and explicitly-approved judgment
# path. Judgment remains protected: only candidates named in lib/models.ts may
# serve it, and it reports unavailable when neither Anthropic nor Groq is set.
GROQ_API_KEY=

# Second factor for step-up actions (production deploys, purchases). Without
# it those actions stay blocked — an unconfigured second factor must not wave
# anything through. See docs/AUTHORITY.md.
MORPHEUS_STEPUP_SECRET=
MORPHEUS_CITY=                      # e.g. Tbilisi
MORPHEUS_LAT=                       # e.g. 41.7151 — required for weather
MORPHEUS_LON=                       # e.g. 44.8271

# ── Voice character ───────────────────────────────────────────────────────
# Defaults aim deep and slow. 0 is the lowest pitch the spec allows; below
# ~0.7 rate the diction starts to smear.
NEXT_PUBLIC_MORPHEUS_VOICE_PITCH=0.68
NEXT_PUBLIC_MORPHEUS_VOICE_RATE=0.88
NEXT_PUBLIC_MORPHEUS_VOICE=         # exact voice name, e.g. "Microsoft David - English (United States)"
# Primary speech path when GROQ_API_KEY is set. The Groq organization must
# accept the Orpheus model terms before this route can replace browser speech.
# Delivery is an original dark mechanical commander, not an actor voiceprint.
# The mechanical chain in lib/voice-chain.ts detunes the returned buffer, which
# also plays it ~12% longer, so the provider is asked for slightly quicker
# delivery to land at a deliberate pace. Verify the whole path with:
#   npm run probe:speech
MORPHEUS_TTS_MODEL=canopylabs/orpheus-v1-english
MORPHEUS_TTS_VOICE=troy
MORPHEUS_TTS_SPEED=1.1
# Known operator identities (profile context only; these do not grant API access)
OPERATOR_FACEBOOK_URL=
OPERATOR_X_URL=
OPERATOR_LINKEDIN_URL=
OPERATOR_LINKEDIN_COMPANY_URL=
OPERATOR_GITHUB_URL=

# Telegram bot access. Keep the real token only in git-ignored .env.local.
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=      # comma-separated numeric Telegram user ids
